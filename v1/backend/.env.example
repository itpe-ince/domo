# Domo Backend Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to version control.

# Database
DATABASE_URL=postgresql+asyncpg://domo:domo_dev_pw@localhost:5432/domo

# JWT
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
PAYMENT_PROVIDER=mock_stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Storage
STORAGE_PROVIDER=local
UPLOAD_DIR=/app/uploads

# Email
EMAIL_PROVIDER=mock
RESEND_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# LLM Gateway — C-1 ai-artist-interview-generation (tuzigroup)
# Leave LLM_GATEWAY_API_KEY empty to use Mock mode (dev/CI friendly).
LLM_GATEWAY_URL=https://llm.tuzigroup.com/v1
LLM_GATEWAY_API_KEY=
LLM_MODEL_NAME=gemma4-e4b

# PostHog (G'-4 backend)
POSTHOG_API_KEY=

# Observability
METRICS_ENABLED=false
METRICS_TOKEN=
