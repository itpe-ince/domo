# Domo Frontend — environment variables reference
# Copy this file to .env.local and fill in the values for local development.
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time (safe to be public).

# ─── Backend API ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3710/v1

# ─── Google Sign-In (GIS) ─────────────────────────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Stripe — Blue Bird 후원 (B-1) ───────────────────────────────────────────
# Stripe Dashboard > Developers > API keys > Publishable key
# 미설정 시 mock 모드 (개발/CI — 실제 결제 없음)
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your_key_here

# ─── PostHog Analytics — A-1 Analytics Foundation ───────────────────────────
# PostHog > Project Settings > Project API Key
# 미설정 시 mock 모드 (개발/CI — console.log fallback, capture 비활성)
# GDPR: opt_out_capturing_by_default=true; 사용자 동의 후 opt_in_capturing()
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# self-hosted 사용 시: NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog.example.com
