# Frontend — production build-time config
# These values are inlined into the client bundle by Next.js at `npm run build`.
# Safe to commit (NEXT_PUBLIC_* is public by definition).
NEXT_PUBLIC_API_URL=https://domo-api.tuzigroup.com/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=160797511268-rul1vevm4hd0chnqohn7ltvk7pqgtrt9.apps.googleusercontent.com

# Blue Bird 후원 — Stripe 공개키 (B-1)
# 프로덕션에서는 실제 pk_live_... 키로 대체
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_your_key_here

# PostHog Analytics — A-1 Analytics Foundation
# 프로덕션에서 실제 phc_... 키로 대체
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
